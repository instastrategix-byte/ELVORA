# ELVORA environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle: never put secrets in them.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) -----------------------------------------------------
# Local values are printed by `npx supabase start` (API URL, Publishable key, Secret key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Used exclusively by payment webhooks and the admin client in backend/src/db/admin.ts.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Auth providers (optional) -----------------------------------------------
# Set to "true" only after enabling Google in Supabase Auth (see docs/DEPLOYMENT_RUNBOOK.md).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Optional: address shown on /help for member support.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Payments (optional until billing is enabled) -----------------------------
# Which provider new checkouts use when a price is configured for both: "stripe" | "razorpay"
PAYMENTS_DEFAULT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional email (optional) -------------------------------------------
# "resend" sends real email; "log" records that an email would have been sent (development only).
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="ELVORA <no-reply@example.com>"

# --- AI writing assistance (optional) -----------------------------------------
# Server-only. When unset, the "Refine with AI" option is hidden.
ANTHROPIC_API_KEY=

# --- Observability -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
