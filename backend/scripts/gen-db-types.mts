/**
 * Generates backend/src/db/database.types.ts from the migrations, using PGlite.
 * Output follows the shape of `supabase gen types typescript` so it can be swapped for the
 * official generator (`npm run db:types:local`) whenever the Docker-based local stack is available.
 *
 *   npm run db:types
 */
import { mkdirSync, writeFileSync } from "node:fs";
import { dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { createMigratedDb } from "../tests/db/pglite.ts";

const OUT = fileURLToPath(new URL("../src/db/database.types.ts", import.meta.url));

type Column = { table_name: string; column_name: string; type: string; elem: string | null; nullable: boolean; has_default: boolean; is_identity: boolean; is_enum: boolean; elem_is_enum: boolean };

const db = await createMigratedDb();

const enums = (
  await db.query<{ name: string; labels: string[] }>(`
    select t.typname as name, array_agg(e.enumlabel order by e.enumsortorder) as labels
    from pg_type t join pg_enum e on e.enumtypid = t.oid join pg_namespace n on n.oid = t.typnamespace
    where n.nspname = 'public' group by t.typname order by t.typname`)
).rows;
const enumNames = new Set(enums.map((e) => e.name));

const columns = (
  await db.query<Column>(`
    select c.relname as table_name, a.attname as column_name, t.typname as type,
      et.typname as elem, not a.attnotnull as nullable,
      (a.atthasdef or a.attidentity <> '') as has_default, a.attidentity <> '' as is_identity,
      t.typtype = 'e' as is_enum, coalesce(et.typtype = 'e', false) as elem_is_enum
    from pg_attribute a
    join pg_class c on c.oid = a.attrelid
    join pg_namespace n on n.oid = c.relnamespace
    join pg_type t on t.oid = a.atttypid
    left join pg_type et on et.oid = t.typelem and t.typcategory = 'A'
    where n.nspname = 'public' and c.relkind = 'r' and a.attnum > 0 and not a.attisdropped
    order by c.relname, a.attnum`)
).rows;

const functions = (
  await db.query<{ name: string; arg_names: string[] | null; arg_types: string[]; arg_modes: string[] | null; n_defaults: number; ret: string; retset: boolean; ret_is_enum: boolean }>(`
    select p.proname as name, p.proargnames as arg_names,
      array(select format_type(unnest(coalesce(p.proallargtypes, p.proargtypes::oid[])), null)) as arg_types,
      p.proargmodes::text[] as arg_modes, p.pronargdefaults as n_defaults,
      t.typname as ret, p.proretset as retset, t.typtype = 'e' as ret_is_enum
    from pg_proc p join pg_namespace n on n.oid = p.pronamespace join pg_type t on t.oid = p.prorettype
    where n.nspname = 'public' and t.typname <> 'trigger'
    order by p.proname`)
).rows;

function scalar(type: string): string {
  const base = type.replace(/^public\./, "").replace(/\[\]$/, "");
  const isArray = type.endsWith("[]") || type.startsWith("_");
  const name = base.replace(/^_/, "");
  let ts: string;
  if (enumNames.has(name)) ts = `Database["public"]["Enums"]["${name}"]`;
  else if (["int2", "int4", "int8", "integer", "bigint", "smallint", "numeric", "float4", "float8", "real", "double precision"].includes(name)) ts = "number";
  else if (["bool", "boolean"].includes(name)) ts = "boolean";
  else if (["json", "jsonb"].includes(name)) ts = "Json";
  else if (name === "void") ts = "undefined";
  else ts = "string";
  return isArray ? `${ts}[]` : ts;
}

function columnType(c: Column): string {
  if (c.elem) return `${scalar(c.elem)}[]`;
  return scalar(c.type);
}

const tables = new Map<string, Column[]>();
for (const c of columns) {
  const list = tables.get(c.table_name) ?? [];
  list.push(c);
  tables.set(c.table_name, list);
}

const lines: string[] = [];
lines.push("// AUTO-GENERATED by backend/scripts/gen-db-types.mts from backend/supabase/migrations. Do not edit by hand.");
lines.push("// Regenerate with `npm run db:types` after changing a migration.");
lines.push("");
lines.push("export type Json = string | number | boolean | null | { [key: string]: Json | undefined } | Json[];");
lines.push("");
lines.push("export type Database = {");
lines.push("  public: {");
lines.push("    Tables: {");
for (const [table, cols] of tables) {
  lines.push(`      ${table}: {`);
  lines.push("        Row: {");
  for (const c of cols) lines.push(`          ${c.column_name}: ${columnType(c)}${c.nullable ? " | null" : ""};`);
  lines.push("        };");
  lines.push("        Insert: {");
  for (const c of cols) {
    if (c.is_identity) continue;
    const optional = c.nullable || c.has_default;
    lines.push(`          ${c.column_name}${optional ? "?" : ""}: ${columnType(c)}${c.nullable ? " | null" : ""};`);
  }
  lines.push("        };");
  lines.push("        Update: {");
  for (const c of cols) {
    if (c.is_identity) continue;
    lines.push(`          ${c.column_name}?: ${columnType(c)}${c.nullable ? " | null" : ""};`);
  }
  lines.push("        };");
  lines.push("        Relationships: [];");
  lines.push("      };");
}
lines.push("    };");
lines.push("    Views: { [_ in never]: never };");
lines.push("    Functions: {");
for (const f of functions) {
  const modes = f.arg_modes ?? f.arg_types.map(() => "i");
  const names = f.arg_names ?? [];
  const inArgs: string[] = [];
  const outCols: string[] = [];
  const inCount = modes.filter((m) => m === "i" || m === "b").length;
  let inIndex = 0;
  modes.forEach((mode, i) => {
    const name = names[i] ?? `arg${i}`;
    const type = scalar(f.arg_types[i]!.replace(/ /g, "_") === "timestamp_with_time_zone" ? "timestamptz" : f.arg_types[i]!);
    if (mode === "i" || mode === "b") {
      const optional = inIndex >= inCount - f.n_defaults;
      inArgs.push(`${name}${optional ? "?" : ""}: ${type}`);
      inIndex++;
    }
    if (mode === "t" || mode === "o" || mode === "b") outCols.push(`${name}: ${type} | null`);
  });
  let returns: string;
  if (outCols.length) returns = `{ ${outCols.join("; ")} }[]`;
  else {
    returns = scalar(f.ret);
    if (f.retset) returns = `${returns}[]`;
  }
  lines.push(`      ${f.name}: {`);
  lines.push(`        Args: ${inArgs.length ? `{ ${inArgs.join("; ")} }` : "Record<PropertyKey, never>"};`);
  lines.push(`        Returns: ${returns};`);
  lines.push("      };");
}
lines.push("    };");
lines.push("    Enums: {");
for (const e of enums) lines.push(`      ${e.name}: ${e.labels.map((l) => JSON.stringify(l)).join(" | ")};`);
lines.push("    };");
lines.push("    CompositeTypes: { [_ in never]: never };");
lines.push("  };");
lines.push("};");
lines.push("");
lines.push('type PublicSchema = Database["public"];');
lines.push('export type Tables<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Row"];');
lines.push('export type TablesInsert<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Insert"];');
lines.push('export type TablesUpdate<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Update"];');
lines.push('export type Enums<T extends keyof PublicSchema["Enums"]> = PublicSchema["Enums"][T];');
lines.push("");

mkdirSync(dirname(OUT), { recursive: true });
writeFileSync(OUT, lines.join("\n"));
await db.close();
console.log(`Wrote ${OUT} (${tables.size} tables, ${functions.length} functions, ${enums.length} enums)`);
